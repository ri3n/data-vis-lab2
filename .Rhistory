dfr <- tribble(
~x, ~y, ~word,
0, -1, "1. This",
2, 2, "2. That",
1, -2, "3. Other",
3, 0, "4. Same",
1, 1, "5. Different"
)
gg <- ggplot(
dfr,
aes(x, y, label = word)
)
gg + geom_text()
gg + geom_label()
gg +
geom_label() +
xlim(-0.2, 3.3) +
ylim(-2.2, 2.2)
gg +
geom_label() +
xlim(-5, 3.3) +
ylim(-5, 2.2)
