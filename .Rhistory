class = c("i", "i", "ii", "ii", "iii"),
extent = c(1, 2, 2, 3, 3),
font_family = c("serif", "sans", "serif", "mono", "mono")
) |>
ggplot(aes(x, y, label = word, color = class, size = extent, family = font_family)) +
xlim(-1, 4) +
ylim(-2.5, 2.5) +
geom_label() +
scale_size_area()
